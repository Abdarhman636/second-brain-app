# Rusookh on Apache hosting (Hostinger). Vite copies this file into dist/.

# The install manifest (home-screen app) must be served as a manifest.
AddType application/manifest+json .webmanifest

RewriteEngine On

# Always HTTPS, and rsookh.com without "www".
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://rsookh.com%{REQUEST_URI} [L,R=301]

# A missing built file is a real 404, never the page: a stylesheet answered
# with HTML leaves the site unstyled instead of showing what's wrong.
RewriteRule ^assets/ - [L]

# A single-page app: any address that isn't a real file (e.g. /projects,
# /s/abc123, /reset-password) opens index.html, and the app shows the page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Built files have a hash in their name, so they can be cached for a year;
# index.html is always checked, so a new upload shows up right away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
